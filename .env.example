# Database (MongoDB — object/document store)
MONGODB_URI=mongodb://localhost:27017/azula

# Auth & Security
JWT_SECRET=change-me-in-production
JWT_EXPIRY=8h
AZULA_ENV=development
# production rejects the default JWT_SECRET and hides GraphQL playground
AZULA_GRAPHQL_PLAYGROUND=false
# Demo: onboarding sample (isSample) always runs Deep + Council even if Fast ≥ 70%.
# Set false to restore skip-on-high-confidence for sample projects too.
AZULA_FORCE_COUNCIL_SAMPLE=true
AZULA_KILL_SWITCH=false
MFA_ISSUER=Azula
TRUSTED_DEVICE_COOKIE_DAYS=30

# LLM — Model A (Fast, local) + Model B (Deep) + Model C (optional API judge)
# Council Challenger picks a different Ollama family when present (pull mistral).
LLM_MODEL_A_PROVIDER=ollama
LLM_MODEL_A_NAME=qwen2.5:1.5b
LLM_MODEL_B_PROVIDER=ollama
LLM_MODEL_B_NAME=azula-incident
LLM_MODEL_C_PROVIDER=openai
LLM_MODEL_C_NAME=gpt-4o-mini
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Concurrency (5 simultaneous investigations)
LLM_WORKER_SLOTS=5
LLM_REQUEST_TIMEOUT=60s

# Fine-tune (LoRA / QLoRA)
FINETUNE_JOB_DIR=./data/finetune
FINETUNE_DEMO_MODE=false

# MCP & Files
MCP_FILE_ROOT=./uploads
SAMPLE_PIPELINE_DIR=./samples/broken-pipeline
FILE_MAX_VERSIONS=10

# GDPR / KVKK
DATA_EXPORT_DIR=./data/exports
CONSENT_REQUIRED=true

# Device OTP email (SMTP optional; codes always written to MAIL_OUTBOX_DIR)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=azula@localhost
MAIL_OUTBOX_DIR=./data/outbox
# Empty = echo the 6-digit code in GraphQL outside production (jury demo).
# Set false to hide it even in development (code still lands in MAIL_OUTBOX_DIR).
# DEVICE_OTP_ECHO=false

# Server
API_PORT=8080
WEB_URL=http://localhost:3001
FREE_TIER_MAX_PROJECTS=3

# Electron
ELECTRON_WEB_URL=http://localhost:3001
AZULA_GRAPHQL=http://localhost:8080/graphql
