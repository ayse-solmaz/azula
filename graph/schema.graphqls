scalar Upload

enum Tier {
  FREE
  PRO
  ENTERPRISE
}

enum InvestigationStatus {
  PENDING
  FAST_CLASSIFY
  DEEP_ANALYZE
  COUNCIL
  COMPLETED
  FAILED
}

enum ExecutionMode {
  LIVE
  FALLBACK
  MIXED
}

enum StepStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
}

type TrustedDevice {
  id: ID!
  name: String!
  createdAt: String!
  lastSeenAt: String!
}

type User {
  id: ID!
  email: String!
  displayName: String!
  tier: Tier!
  mfaEnabled: Boolean!
  orgId: ID
  orgName: String
  orgRole: String
  trustedDevices: [TrustedDevice!]!
  ssoLinked: Boolean!
  disabled: Boolean!
  createdAt: String!
  notifyEmail: Boolean!
  notifyInvestigations: Boolean!
  notifyMarketing: Boolean!
  shareUsage: Boolean!
}

enum OrgRole {
  ADMIN
  ENGINEER
  VIEWER
}

type OrgMember {
  email: String!
  role: String!
  userId: ID
}

type AuthPayload {
  token: String
  user: User
  mfaRequired: Boolean!
  newDevice: Boolean!
  ephemeralCode: String
}

type FileVersion {
  fileName: String!
  version: Int!
  uploadedAt: String!
}

type ConsentRecord {
  purpose: String!
  accepted: Boolean!
  createdAt: String!
}

type AuditLog {
  id: ID!
  action: String!
  resource: String!
  createdAt: String!
}

type FineTuneJob {
  id: ID!
  workspaceId: ID!
  status: String!
  adapterPath: String!
  error: String
  createdAt: String!
}

type Organization {
  id: ID!
  name: String!
  members: [OrgMember!]!
}

type MfaEnrollPayload {
  secret: String!
  otpauthUrl: String!
}

type Workspace {
  id: ID!
  name: String!
  projects: [Project!]!
}

type Project {
  id: ID!
  workspaceId: ID!
  name: String!
  isSample: Boolean!
  files: [ProjectFile!]!
  investigations: [Investigation!]!
  gitRepo: GitRepo
}

type ProjectFile {
  name: String!
  path: String!
  mimeType: String!
  uploadedAt: String!
  content: String
}

type PlanStep {
  order: Int!
  description: String!
  status: StepStatus!
}

type Evidence {
  file: String!
  lines: String!
  excerpt: String!
}

type FastResult {
  summary: String!
  incidentType: String!
  confidence: Float!
}

type DeepResult {
  rootCause: String!
  confidence: Float!
  evidence: [Evidence!]!
  suggestedFix: String!
}

type CouncilModel {
  role: String!
  hypothesis: String!
  confidence: Float!
  evidence: [Evidence!]!
  model: String
}

type Disagreement {
  topic: String!
  investigator: String!
  challenger: String!
}

type FinalJudgment {
  mostLikelyCause: String!
  confidence: Float!
  recommendedAction: String!
}

type CouncilResult {
  models: [CouncilModel!]!
  agreements: [String!]!
  disagreements: [Disagreement!]!
  finalJudgment: FinalJudgment!
  aggregation: String!
  needsReview: Boolean!
  aggregationNote: String!
}

type Investigation {
  id: ID!
  projectId: ID!
  prompt: String!
  status: InvestigationStatus!
  plan: [PlanStep!]!
  filesAccessed: [String!]!
  fastResult: FastResult
  deepResult: DeepResult
  councilResult: CouncilResult
  errorMessage: String
  modelAName: String
  modelBName: String
  modelCName: String
  escalationReason: String
  executionMode: ExecutionMode
  fallbackStages: [String!]!
  createdAt: String!
}

type ModelConfig {
  workspaceId: ID!
  modelAProvider: String!
  modelAName: String!
  modelBProvider: String!
  modelBName: String!
  modelCProvider: String!
  modelCName: String!
  temperature: Float!
  maxTokens: Int!
  investigatorPrompt: String!
  challengerPrompt: String!
  judgePrompt: String!
  activeSlot: String!
}

input ModelConfigInput {
  workspaceId: ID!
  modelAProvider: String
  modelAName: String
  modelBProvider: String
  modelBName: String
  modelCProvider: String
  modelCName: String
  temperature: Float
  maxTokens: Int
  investigatorPrompt: String
  challengerPrompt: String
  judgePrompt: String
  activeSlot: String
}

type LLMOpsMetrics {
  totalInvestigations: Int!
  completed: Int!
  failed: Int!
  avgConfidence: Float!
  avgDurationSec: Float!
  workerSlots: Int!
  busySlots: Int!
  modelAName: String!
  modelBName: String!
  ollamaReachable: Boolean!
  ollamaModels: [String!]!
  incidentModelReady: Boolean!
  adapterOnDisk: Boolean!
  topCauses: [String!]!
}

type GitRepo {
  url: String!
  branch: String!
  head: String!
  connected: Boolean!
}

type GitBlameLine {
  line: Int!
  sha: String!
  author: String!
  summary: String!
}

type GitCommit {
  sha: String!
  author: String!
  date: String!
  message: String!
}

type MetricDelta {
  name: String!
  before: Float!
  after: Float!
  delta: Float!
}

type Generation {
  id: ID!
  projectId: ID!
  investigationId: ID
  prompt: String!
  fileName: String!
  rowCount: Int!
  schemaNote: String!
  qualityNotes: String!
  confidence: Float!
  status: String!
  error: String
  createdAt: String!
}

type Evaluation {
  id: ID!
  projectId: ID!
  investigationId: ID
  generationId: ID
  summary: String!
  recommendation: String!
  confidence: Float!
  metrics: [MetricDelta!]!
  status: String!
  error: String
  createdAt: String!
}

type Entitlements {
  tier: Tier!
  maxProjects: Int!
  maxInvestigationsPerMonth: Int!
  investigationsUsed: Int!
  deepAnalysis: Boolean!
  council: Boolean!
  generate: Boolean!
  evaluate: Boolean!
  gitMcp: Boolean!
  modelSelection: Boolean!
  teamWorkspace: Boolean!
  billingConfigured: Boolean!
  ssoEnabled: Boolean!
  demoUpgrade: Boolean!
}

type AuthFeatures {
  ssoEnabled: Boolean!
  billingEnabled: Boolean!
  demoUpgrade: Boolean!
}

type CheckoutPayload {
  url: String!
}

type Query {
  me: User
  workspaces: [Workspace!]!
  project(id: ID!): Project
  investigation(id: ID!): Investigation
  investigations(projectId: ID!): [Investigation!]!
  modelConfig(workspaceId: ID!): ModelConfig!
  llmOpsMetrics(workspaceId: ID!): LLMOpsMetrics!
  fileContent(projectId: ID!, name: String!): String!
  fileVersions(projectId: ID!, fileName: String!): [FileVersion!]!
  fileVersionContent(projectId: ID!, fileName: String!, version: Int!): String!
  myOrganization: Organization
  fineTuneJobs(workspaceId: ID!): [FineTuneJob!]!
  myConsent: ConsentRecord
  auditLogs: [AuditLog!]!
  authFeatures: AuthFeatures!
  entitlements: Entitlements!
  generations(projectId: ID!): [Generation!]!
  evaluations(projectId: ID!): [Evaluation!]!
  gitRepo(projectId: ID!): GitRepo!
  gitBlame(projectId: ID!, path: String!): [GitBlameLine!]!
  gitDiff(projectId: ID!, refA: String, refB: String): String!
  gitLog(projectId: ID!, limit: Int): [GitCommit!]!
}

type Mutation {
	register(email: String!, password: String!, deviceId: String, deviceName: String): AuthPayload!
  login(email: String!, password: String!, mfaCode: String, deviceId: String, deviceName: String, deviceOtp: String): AuthPayload!
  logout: Boolean!
  enrollMfa: MfaEnrollPayload!
  enableMfa(code: String!): User!
  disableMfa(code: String!): User!
  revokeTrustedDevice(deviceId: ID!): User!
  createWorkspace(name: String!): Workspace!
  createProject(workspaceId: ID!, name: String!, isSample: Boolean): Project!
  uploadFile(projectId: ID!, file: Upload!): ProjectFile!
  updateModelConfig(input: ModelConfigInput!): ModelConfig!
	startInvestigation(projectId: ID!, prompt: String): Investigation!
  cancelInvestigation(id: ID!): Investigation!
  swapFileVersion(projectId: ID!, fileName: String!, version: Int!): ProjectFile!
  deleteAccount: Boolean!
  exportMyData: String!
  recordConsent(purpose: String!, accepted: Boolean!): ConsentRecord!
  startFineTuneJob(workspaceId: ID!): FineTuneJob!
  attachIncidentModel(workspaceId: ID!): ModelConfig!
  createOrganization(name: String!): Organization!
  inviteOrgMember(email: String!, role: String!): Organization!
  updateOrgMemberRole(email: String!, role: String!): Organization!
  removeOrgMember(email: String!): Organization!
  generateDataset(projectId: ID!, investigationId: ID, prompt: String): Generation!
  evaluateFix(projectId: ID!, investigationId: ID, generationId: ID, prompt: String): Evaluation!
  connectGitRepo(projectId: ID!, url: String!, branch: String): GitRepo!
  createCheckoutSession: CheckoutPayload!
  activateProDemo: User!
  updateProfile(displayName: String!): User!
  changePassword(currentPassword: String!, newPassword: String!): Boolean!
  updateAccountPrefs(notifyEmail: Boolean, notifyInvestigations: Boolean, notifyMarketing: Boolean, shareUsage: Boolean): User!
  deactivateAccount: Boolean!
}
